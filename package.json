{
  "name": "dsh-auto-review-fix",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Fixes DSH Auto review failing closed. Three reviewer failure modes are handled with session-route validation, a fallback route, and an ask fallback instead of a dead tool channel.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "auto-review",
    "llm",
    "reliability"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/plugin.test.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
